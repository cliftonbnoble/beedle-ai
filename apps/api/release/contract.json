    "state": "SELECT (SELECT schema_version FROM search_schema_readiness WHERE singleton=1) AS searchSchemaVersion,\n (SELECT phase FROM search_index_build WHERE singleton=1) AS substrings,(SELECT phase FROM search_phrase_build WHERE singleton=1) AS phrases,(SELECT phase FROM search_facet_build WHERE singleton=1) AS facets,\n (SELECT CASE WHEN generation='legacy' AND status='idle' THEN 1 WHEN status='completed' AND EXISTS(SELECT 1 FROM search_index_generations g WHERE g.generation=search_index_rebuild.generation AND g.status='completed') THEN 1 ELSE 0 END FROM search_index_rebuild WHERE singleton=1) AS recoveryValid,\n (SELECT phase FROM reviewer_queue_control WHERE singleton=1) AS reviewerPhase,(SELECT policy_version FROM reviewer_queue_control WHERE singleton=1) AS reviewerPolicy,\n (SELECT catalog_version FROM reviewer_queue_control WHERE singleton=1) AS reviewerCatalog,(SELECT COUNT(*) FROM reviewer_queue_sources WHERE dirty=1) AS reviewerPending,\n (SELECT COUNT(*) FROM documents) AS sourceCount,(SELECT COUNT(*) FROM reviewer_queue_state) AS reviewerCount,\n (SELECT active_version FROM legal_catalog_state WHERE singleton=1) AS activeCatalog,\n (SELECT COUNT(*) FROM legal_catalog_state s JOIN legal_catalog_versions v ON v.id=s.active_version JOIN legal_reference_editions e ON e.catalog_id=v.id WHERE s.singleton=1 AND v.state='published') AS catalogReady,\n (SELECT revision FROM vector_lifecycle_epoch WHERE singleton=1) AS corpusRevision,\n (SELECT COUNT(*) FROM vector_lifecycle_dirty d WHERE NOT EXISTS(SELECT 1 FROM vector_profiles p JOIN vector_profile_sync s ON s.profile_id=p.id AND s.document_id=d.document_id JOIN vector_filter_sync f ON f.profile_id=p.id AND f.document_id=d.document_id WHERE p.id=?1 AND s.revision=d.revision AND f.revision=d.revision)) AS vectorPending,\n (SELECT MAX(CAST(substr(name,1,4) AS INTEGER)) FROM d1_migrations) AS latestMigration,\n (SELECT COUNT(*) FROM document_chunks c JOIN documents d ON d.id=c.document_id WHERE ((d.ingestion_state = 'ready' AND d.ingestion_completed_at IS NOT NULL\n    AND d.expected_chunk_count > 0 AND d.rejected_at IS NULL\n    AND COALESCE(d.source_r2_key, '') != ''\n    AND NOT EXISTS(SELECT 1 FROM document_source_revisions sr JOIN source_records rec ON rec.record_id=sr.record_id\n      WHERE sr.document_id=d.id AND rec.published_source_revision>sr.source_revision)) AND d.searchable_at IS NOT NULL\n    AND d.published_revision = d.document_revision) AND NOT EXISTS(SELECT 1 FROM vector_entries e WHERE e.profile_id=?1 AND e.document_id=d.id AND e.chunk_id=c.id AND e.source_kind='document' AND e.source_generation=d.active_text_generation AND e.source_sha256=json_extract(d.metadata_json,'$.sourceSha256') AND e.chunk_text=c.chunk_text AND e.state='verified' AND e.metadata_live=1 AND e.obsolete_at IS NULL)) AS vectorMissing"
