",\"search_index_rebuild\",\"search_index_rebuild_guards\",\"search_index_start_guards\",\"search_metadata_substrings\",\"search_metadata_substrings_config\",\"search_metadata_substrings_data\",\"search_metadata_substrings_docsize\",\"search_metadata_substrings_idx\",\"search_phrase_build\",\"search_phrase_build_guards\",\"search_schema_readiness\",\"search_session_capacity\",\"search_sessions\",\"section_paragraphs\",\"source_records\",\"staged_document_chunks\",\"staged_document_reference_issues\",\"staged_document_reference_links\",\"staged_document_sections\",\"staged_section_paragraphs\",\"vector_document_metadata\",\"vector_entries\",\"vector_filter_sync\",\"vector_lifecycle_dirty\",\"vector_lifecycle_epoch\",\"vector_profile_sync\",\"vector_profiles\",\"vector_submission_guards\",\"vector_sync_locks\"]')) ORDER BY m.name,p.cid LIMIT 5001",
