{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "beedle-migration-unconfigured",
  "main": "src/migration-backfill.ts",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "MIGRATION_ENABLED": "false",
    "MIGRATION_RUN_ID": "not-configured",
    "MIGRATION_TARGET_SHA256": "not-configured",
    "MIGRATION_BUNDLE_SHA256": "not-configured"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "beedle-migration-unconfigured",
    "database_id": "00000000-0000-0000-0000-000000000002"
  }],
  "triggers": { "crons": [] },
  "limits": { "cpu_ms": 30000 },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
