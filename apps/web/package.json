    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/next-on-pages": "1.13.16",
    "@cloudflare/workers-types": "^4.20260307.1",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.6.3",
    "vercel": "47.0.4",
    "wrangler": "^4.71.0"
